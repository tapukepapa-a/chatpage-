{
  "name": "just-us-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:all": "concurrently -n FRONTEND,BACKEND -c blue,green \"npm run dev\" \"npm run dev --prefix backend\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "npm run dev --prefix backend",
    "server:start": "npm start --prefix backend",
    "server:test": "npm test --prefix backend",
    "config:db": "npm run config:db --prefix backend"
  },  
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.2",
    "concurrently": "^8.2.2"
  }
}